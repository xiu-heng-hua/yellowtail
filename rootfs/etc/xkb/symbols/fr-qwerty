default partial alphanumeric_keys
xkb_symbols "basic" {

    name[Group1]= "French (QWERTY)";

    key <TLDE> {[ grave,  asciitilde,      VoidSymbol,     VoidSymbol ]};
    key <AE01> {[     1,      exclam,          agrave,         Agrave ]};
    key <AE02> {[     2,          at,          eacute,         Eacute ]};
    key <AE03> {[     3,  numbersign,          egrave,         Egrave ]};
    key <AE04> {[     4,      dollar,     ecircumflex,    Ecircumflex ]};
    key <AE05> {[     5,     percent,      VoidSymbol,     VoidSymbol ]};
    key <AE06> {[     6, asciicircum,      VoidSymbol,     VoidSymbol ]};
    key <AE07> {[     7,   ampersand,      VoidSymbol,     VoidSymbol ]};
    key <AE08> {[     8,    asterisk,      VoidSymbol,     VoidSymbol ]};
    key <AE09> {[     9,   parenleft,      VoidSymbol,     VoidSymbol ]};
    key <AE10> {[     0,  parenright,      VoidSymbol,     VoidSymbol ]};
    key <AE11> {[ minus,  underscore,      VoidSymbol,     VoidSymbol ]};
    key <AE12> {[ equal,        plus, dead_circumflex, dead_diaeresis ]};

    key <AD01> {[            q,          Q,     VoidSymbol, VoidSymbol ]};
    key <AD02> {[            w,          W,     VoidSymbol, VoidSymbol ]};
    key <AD03> {[            e,          E,       EuroSign, VoidSymbol ]};
    key <AD04> {[            r,          R,     VoidSymbol, VoidSymbol ]};
    key <AD05> {[            t,          T,     VoidSymbol, VoidSymbol ]};
    key <AD06> {[            y,          Y,     VoidSymbol, VoidSymbol ]};
    key <AD07> {[            u,          U,         ugrave,     Ugrave ]};
    key <AD08> {[            i,          I,     VoidSymbol, VoidSymbol ]};
    key <AD09> {[            o,          O,             oe,         OE ]};
    key <AD10> {[            p,          P,     VoidSymbol, VoidSymbol ]};
    key <AD11> {[  bracketleft,  braceleft,  guillemotleft, VoidSymbol ]};
    key <AD12> {[ bracketright, braceright, guillemotright, VoidSymbol ]};

    key <AC01> {[          a,        A,            ae,         AE ]};
    key <AC02> {[          s,        S,    VoidSymbol, VoidSymbol ]};
    key <AC03> {[          d,        D,    VoidSymbol, VoidSymbol ]};
    key <AC04> {[          f,        F, dead_currency, VoidSymbol ]};
    key <AC05> {[          g,        G,    dead_greek, VoidSymbol ]};
    key <AC06> {[          h,        H,    VoidSymbol, VoidSymbol ]};
    key <AC07> {[          j,        J,    VoidSymbol, VoidSymbol ]};
    key <AC08> {[          k,        K,    VoidSymbol, VoidSymbol ]};
    key <AC09> {[          l,        L,    VoidSymbol, VoidSymbol ]};
    key <AC10> {[  semicolon,    colon,    VoidSymbol, VoidSymbol ]};
    key <AC11> {[ apostrophe, quotedbl,    VoidSymbol, VoidSymbol ]};
    key <BKSL> {[  backslash,      bar,    VoidSymbol, VoidSymbol ]};

    key <AB01> {[      z,        Z, VoidSymbol, VoidSymbol ]};
    key <AB02> {[      x,        X, VoidSymbol, VoidSymbol ]};
    key <AB03> {[      c,        C,   ccedilla,   Ccedilla ]};
    key <AB04> {[      v,        V, VoidSymbol, VoidSymbol ]};
    key <AB05> {[      b,        B, VoidSymbol, VoidSymbol ]};
    key <AB06> {[      n,        N, VoidSymbol, VoidSymbol ]};
    key <AB07> {[      m,        M, VoidSymbol, VoidSymbol ]};
    key <AB08> {[  comma,     less, VoidSymbol, VoidSymbol ]};
    key <AB09> {[ period,  greater, VoidSymbol, VoidSymbol ]};
    key <AB10> {[  slash, question, VoidSymbol, VoidSymbol ]};

    include "level3(ralt_switch)"
};
