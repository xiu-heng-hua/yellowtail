default partial alphanumeric_keys
xkb_symbols "basic" {

    name[Group1]= "French (QWERTY)";

    key <TLDE> {[ grave,  asciitilde,            none,           none ]};
    key <AE01> {[     1,      exclam,          agrave,         Agrave ]};
    key <AE02> {[     2,          at,          eacute,         Eacute ]};
    key <AE03> {[     3,  numbersign,          egrave,         Egrave ]};
    key <AE04> {[     4,      dollar,     ecircumflex,    Ecircumflex ]};
    key <AE05> {[     5,     percent,            none,           none ]};
    key <AE06> {[     6, asciicircum,            none,           none ]};
    key <AE07> {[     7,   ampersand,            none,           none ]};
    key <AE08> {[     8,    asterisk,            none,           none ]};
    key <AE09> {[     9,   parenleft,            none,           none ]};
    key <AE10> {[     0,  parenright,            none,           none ]};
    key <AE11> {[ minus,  underscore,            none,           none ]};
    key <AE12> {[ equal,        plus, dead_circumflex, dead_diaeresis ]};

    key <AD01> {[            q,          Q,           none,   none ]};
    key <AD02> {[            w,          W,           none,   none ]};
    key <AD03> {[            e,          E,       EuroSign,   none ]};
    key <AD04> {[            r,          R,           none,   none ]};
    key <AD05> {[            t,          T,           none,   none ]};
    key <AD06> {[            y,          Y,           none,   none ]};
    key <AD07> {[            u,          U,         ugrave, Ugrave ]};
    key <AD08> {[            i,          I,           none,   none ]};
    key <AD09> {[            o,          O,             oe,     OE ]};
    key <AD10> {[            p,          P,           none,   none ]};
    key <AD11> {[  bracketleft,  braceleft,  guillemotleft,   none ]};
    key <AD12> {[ bracketright, braceright, guillemotright,   none ]};

    key <AC01> {[          a,        A,              ae,   AE ]};
    key <AC02> {[          s,        S,            none, none ]};
    key <AC03> {[          d,        D,            none, none ]};
    key <AC04> {[          f,        F,   dead_currency, none ]};
    key <AC05> {[          g,        G,      dead_greek, none ]};
    key <AC06> {[          h,        H,            none, none ]};
    key <AC07> {[          j,        J,            none, none ]};
    key <AC08> {[          k,        K,            none, none ]};
    key <AC09> {[          l,        L,            none, none ]};
    key <AC10> {[  semicolon,    colon,            none, none ]};
    key <AC11> {[ apostrophe, quotedbl,            none, none ]};
    key <BKSL> {[  backslash,      bar,            none, none ]};

    key <AB01> {[      z,        Z,     none,     none ]};
    key <AB02> {[      x,        X,     none,     none ]};
    key <AB03> {[      c,        C, ccedilla, Ccedilla ]};
    key <AB04> {[      v,        V,     none,     none ]};
    key <AB05> {[      b,        B,     none,     none ]};
    key <AB06> {[      n,        N,     none,     none ]};
    key <AB07> {[      m,        M,     none,     none ]};
    key <AB08> {[  comma,     less,     none,     none ]};
    key <AB09> {[ period,  greater,     none,     none ]};
    key <AB10> {[  slash, question,     none,     none ]};

    include "level3(ralt_switch)"
};
